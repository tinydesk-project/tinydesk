# tinydesk on the ESP32-S3 with PSRAM (tested on an ESP32-S3R8: 16 MB flash,
# 8 MB octal PSRAM in the chip), ESP-IDF 5.3.1.

# --- The USB Serial/JTAG port belongs to tinydesk alone -----------------
# The ESP-IDF console is off (logs go to the Log Viewer app), also the
# secondary console that would write to USB Serial/JTAG. The bootloader is
# quiet, and the app starts at WARN and raises the level to INFO once the
# ROM's USB output is detached (see main.c).
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y

# 1 ms scheduler tick keeps the UI loop (5 ms sleep) responsive.
CONFIG_FREERTOS_HZ=1000

# --- Flash and PSRAM -----------------------------------------------------
# Same 16 MB layout as the classic ESP32 port: two 3 MB update slots.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
# "R8" chips and modules (ESP32-S3R8, -N16R8...) have octal PSRAM; ESP-IDF's
# default for the S3 is quad, and the firmware would then stop at boot.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# Static buffers of tinydesk and TinyDesk Shell go to PSRAM (main/extram.lf).
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- TinyDesk Shell settings (as on the other ports) ------------------------
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=6144
CONFIG_VFS_SUPPORT_DIR=y
# Board wiring (RS-485, W6100 Ethernet, SD card...) is not configured here:
# see board.example.conf.

# --- Firmware updates (OTA) and TLS -----------------------------------------
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# Task Manager: task list and CPU shares (a few bytes per task).
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# FreeRTOS kernel code (non-ISR functions) in flash: more IRAM for the rest
# of the firmware.
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y

# SD card (sd mount): FAT with long file names in UTF-8, the name buffer on
# the heap only while a call runs.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
