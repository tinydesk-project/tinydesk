        "fill": {"params": ["x", "y", "w", "h", "ch", "fg", "bg"], "required": 4},
        "focus": {"params": [], "required": 0},
        "font_text": {"params": ["font", "x", "y", "w", "h", "text", "fg", "bg", "align", "valign", "wrap"], "required": 6},
        "gradient": {"params": ["x", "y", "w", "h", "rgb1", "rgb2", "across"], "required": 6},
        "image": {"params": ["img", "x", "y", "w", "h", "src"], "required": 3},
        "line": {"params": ["x0", "y0", "x1", "y1", "color"], "required": 5},
        "move": {"params": ["x", "y"], "required": 2},
        "nine": {"params": ["img", "x", "y", "w", "h", "border", "src"], "required": 6},
        "pheight": {"property": true},
        "picture": {"params": ["img", "x", "y", "w", "h", "src", "border", "text", "fg", "scale", "font"], "required": 5},
        "pixels": {"params": ["x", "y", "w", "h", "data", "rgb", "dither"], "required": 5},
        "put": {"params": ["x", "y", "text", "fg", "bg"], "required": 3},
        "pwidth": {"property": true},
        "rect": {"params": ["x", "y", "w", "h", "color", "radius", "outline", "gradient"], "required": 5},
        "resize": {"params": ["w", "h"], "required": 2},
        "show": {"params": ["page"], "required": 1},
        "text": {"property": true},
        "visible": {"property": true}
      },
      "CanvasButton": {
        "draw": {"params": ["pressed"], "required": 0},
        "remove": {"params": [], "required": 0},
        "text": {"property": true}
      },
      "Checkbox": {
        "checked": {"property": true},
        "color": {"params": ["fg", "bg"], "required": 0},
        "focus": {"params": [], "required": 0},
        "text": {"property": true},
        "visible": {"property": true}
      },
      "Font": {
        "free": {"params": [], "required": 0},
        "load": {"params": ["path"], "required": 1}
      },
      "Image": {
        "bar": {"params": ["x", "y", "w", "h", "value", "maximum", "color", "track", "edge", "radius", "gradient"], "required": 5},
        "batch": {"params": [], "required": 0},
        "circle": {"params": ["x", "y", "r", "color", "outline", "gradient"], "required": 4},
        "draw_text": {"params": ["x", "y", "text", "color", "bg", "scale", "small"], "required": 4},
        "free": {"params": [], "required": 0},
        "gradient": {"params": ["x", "y", "w", "h", "rgb1", "rgb2", "across"], "required": 6},
        "image": {"params": ["img", "x", "y", "w", "h", "src"], "required": 3},
        "line": {"params": ["x0", "y0", "x1", "y1", "color"], "required": 5},
        "load": {"params": ["path", "w", "h", "key", "dither"], "required": 1},
        "nine": {"params": ["img", "x", "y", "w", "h", "border", "src"], "required": 6},
        "pixels": {"params": ["x", "y", "w", "h", "data", "rgb", "dither"], "required": 5},
        "rect": {"params": ["x", "y", "w", "h", "color", "radius", "outline", "gradient"], "required": 5}
      },
      "Label": {
        "color": {"params": ["fg", "bg"], "required": 0},
        "focus": {"params": [], "required": 0},
        "text": {"property": true},
        "visible": {"property": true}
      },
      "List": {
        "append": {"params": ["item"], "required": 1},
        "color": {"params": ["fg", "bg"], "required": 0},
        "focus": {"params": [], "required": 0},
        "items": {"property": true},
        "selected": {"property": true},
        "text": {"property": true},
        "visible": {"property": true}
      },
      "Progress": {
        "color": {"params": ["fg", "bg"], "required": 0},
        "focus": {"params": [], "required": 0},
        "text": {"property": true},
        "value": {"property": true},
        "visible": {"property": true}
      },
      "Textbox": {
        "color": {"params": ["fg", "bg"], "required": 0},
        "focus": {"params": [], "required": 0},
        "text": {"property": true},
        "visible": {"property": true}
      },
      "Timer": {
        "cancel": {"params": [], "required": 0}
      },
      "Window": {
        "after": {"params": ["ms", "fn"], "required": 2},
        "button": {"params": ["x", "y", "text", "on_click"], "required": 3},
        "canvas": {"params": ["x", "y", "w", "h", "on_mouse", "pages"], "required": 4},
        "checkbox": {"params": ["x", "y", "text", "checked", "on_change"], "required": 3},
        "close": {"params": [], "required": 0},
