        "batch": {"params": [], "required": 0},
        "big": {"params": ["x", "y", "text", "fg", "bg", "scale", "width"], "required": 3},
        "button": {"params": ["x", "y", "w", "h", "text", "on_click", "color", "down", "rim", "fg", "radius", "scale", "sheet", "src", "src_down", "border", "on_press", "on_release", "on_cancel", "font", "gradient"], "required": 5},
        "circle": {"params": ["x", "y", "r", "color", "outline", "gradient"], "required": 4},
        "clear": {"params": ["fg", "bg"], "required": 0},
