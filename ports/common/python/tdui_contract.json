        "focus": {"params": [], "required": 0},
        "fullscreen": {"params": [], "required": 0},
        "label": {"params": ["x", "y", "text", "width"], "required": 2},
        "list": {"params": ["x", "y", "w", "h", "items", "on_select", "on_activate"], "required": 4},
        "maximize": {"params": [], "required": 0},
        "minimize": {"params": [], "required": 0},
        "move": {"params": ["x", "y"], "required": 2},
        "progress": {"params": ["x", "y", "width", "value"], "required": 3},
        "resize": {"params": ["w", "h"], "required": 2},
        "restore": {"params": [], "required": 0},
        "textbox": {"params": ["x", "y", "width", "text", "secret", "on_enter", "on_change"], "required": 3},
        "title": {"property": true}
      }
