# tinydesk on the classic ESP32 (ESP32-WROVER-IE: 16 MB flash, 8 MB PSRAM),
# ESP-IDF 5.3.1.

# --- UART0 belongs to the desktop -----------------------------------------
# The ESP-IDF console is off (logs go to the Log Viewer app), the bootloader
# is quiet, and the app starts at WARN and raises the level to INFO once
# the ROM's UART output is detached (see main.c).
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y

CONFIG_FREERTOS_HZ=1000

# --- Flash and PSRAM -----------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# ESP32 revision 3 or later (every WROVER-E/IE, sold since 2019): no
# workaround for the early chips' PSRAM cache bug, which kept parts of the C
# library in IRAM and slowed PSRAM. That IRAM is what Bluetooth Classic
# (Bluedroid) needs. Older chips refuse this image at boot, saying why.
CONFIG_ESP32_REV_MIN_3=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- TinyDesk Shell settings (as on the C6) -----------------------------------------
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=6144
CONFIG_VFS_SUPPORT_DIR=y
# Board wiring (console UART, RS-485, W6100 Ethernet, SD card...) is not
# configured here: see board.example.conf.

# --- Firmware updates (OTA) and TLS -----------------------------------------
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# Static buffers of tinydesk and TinyDesk Shell go to PSRAM (main/extram.lf).
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Task Manager: task list and CPU shares (a few bytes per task).
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# FreeRTOS kernel code (non-ISR functions) in flash: frees about 8 KB of
# IRAM, which the RS-485 driver and the rest of the firmware need.
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y

# SD card (sd mount): FAT with long file names in UTF-8, the name buffer on
# the heap only while a call runs.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y

# Bluetooth keyboards and mice, Classic and LE (bt_hid_bluedroid.c; off
# unless board key bt.enable = 1): Bluedroid in dual mode with its HID host,
# the classic ESP32 being the one chip with a Classic radio. Its memory
# from PSRAM where it can be.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_HID_ENABLED=y
CONFIG_BT_HID_HOST_ENABLED=y
CONFIG_BT_SSP_ENABLED=y
CONFIG_BT_GATTC_NOTIF_REG_MAX=16
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y
CONFIG_BT_LOG_HCI_TRACE_LEVEL_WARNING=y
