# Regenerates third_party/micropython from a MicroPython checkout: the
# interpreter sources TinyDesk builds, and the headers MicroPython generates
# from them (qstrs, module and root-pointer tables, version). Based on
# MicroPython's ports/embed/embed.mk, plus the extmod modules and shared
# code the `py` command uses, TinyDesk's own port files, and the frozen
# Python modules of ports/common/python/manifest.py (asyncio).
#
# Run it through gen.sh (Linux or WSL: needs make, gcc and python3).

ifeq ($(MICROPYTHON_TOP),)
$(error set MICROPYTHON_TOP to a MicroPython checkout, see README.md)
endif

TD_ROOT := $(abspath ../..)
PORT_DIR := $(TD_ROOT)/ports/common/python
PACKAGE_DIR := $(TD_ROOT)/third_party/micropython
BUILD := build

include $(MICROPYTHON_TOP)/py/mkenv.mk
include $(TOP)/py/py.mk

# py.mk lists mpconfigport.h as a dependency of every generated header.
vpath mpconfigport.h $(PORT_DIR)

# Names the generator cannot see in use (see qstrdefsport.h).
QSTR_DEFS += $(PORT_DIR)/qstrdefsport.h

# The same include paths as the real builds, so the port files preprocess
# as they compile. No platform macros are defined here: code inside
# #ifdef ESP_PLATFORM / _WIN32 must not introduce qstrs. TD_PY_GENHDR turns
# on both native-code emitters (Xtensa for the ESP32, x64 for Linux), so
# the tables have the names of each.
CFLAGS += -DTD_PY_GENHDR -I$(PORT_DIR) -I$(TOP) -I$(BUILD) \
	-I$(TD_ROOT)/include -I$(TD_ROOT)/apps -I$(TD_ROOT)/proto \
	-I$(TD_ROOT)/third_party/tdsh/include -std=gnu11

EXTMOD_C := \
	extmod/modasyncio.c \
	extmod/modbinascii.c \
	extmod/modhashlib.c \
	extmod/modheapq.c \
	extmod/modjson.c \
	extmod/modos.c \
	extmod/modrandom.c \
	extmod/modre.c \
	extmod/modselect.c \
	extmod/modtime.c \
	extmod/vfs.c \
	extmod/vfs_posix_file.c \
	extmod/vfs_reader.c

SHARED_C := \
	shared/readline/readline.c \
	shared/runtime/gchelper_generic.c \
	shared/runtime/interrupt_char.c \
	shared/runtime/pyexec.c \
	shared/runtime/stdout_helpers.c \
	shared/runtime/sys_stdio_mphal.c \
	shared/timeutils/timeutils.c

PORT_C := $(wildcard $(PORT_DIR)/*.c)

SRC_QSTR += $(EXTMOD_C) $(SHARED_C) $(PORT_C)

GENHDR_OUTPUT := $(addprefix $(HEADER_BUILD)/, \
	moduledefs.h \
	mpversion.h \
	qstrdefs.generated.h \
	root_pointers.h \
	)

# Frozen modules: mpy-cross (built from the checkout) compiles them, and
# makemanifest.py writes them as C, with their own extra qstr pool.
MPY_CROSS := $(TOP)/mpy-cross/build/mpy-cross
FROZEN_C := $(BUILD)/frozen_content.c

$(MPY_CROSS):
	$(MAKE) -C $(TOP)/mpy-cross

$(FROZEN_C): $(PORT_DIR)/manifest.py $(GENHDR_OUTPUT) $(MPY_CROSS)
	$(ECHO) "GEN $@"
	$(Q)MICROPY_MPYCROSS=$(MPY_CROSS) $(MAKE_MANIFEST) -o $@ -v "MPY_DIR=$(TOP)" -v "PORT_DIR=$(PORT_DIR)" -b "$(BUILD)" \
		--mpy-tool-flags="-mlongint-impl=mpz" $(PORT_DIR)/manifest.py

.PHONY: all package
all: package

# README.md (written by hand) stays; everything else is replaced.
package: $(GENHDR_OUTPUT) $(FROZEN_C)
	$(ECHO) "Package into $(PACKAGE_DIR)"
	$(Q)$(RM) -rf $(PACKAGE_DIR)/py $(PACKAGE_DIR)/extmod $(PACKAGE_DIR)/shared $(PACKAGE_DIR)/lib $(PACKAGE_DIR)/genhdr \
		$(PACKAGE_DIR)/frozen
	$(Q)$(MKDIR) -p $(PACKAGE_DIR)/py $(PACKAGE_DIR)/extmod $(PACKAGE_DIR)/genhdr \
		$(PACKAGE_DIR)/shared/readline $(PACKAGE_DIR)/shared/runtime $(PACKAGE_DIR)/shared/timeutils \
		$(PACKAGE_DIR)/lib/re1.5 $(PACKAGE_DIR)/lib/crypto-algorithms $(PACKAGE_DIR)/frozen
	$(Q)$(CP) $(TOP)/py/*.[ch] $(PACKAGE_DIR)/py
	$(Q)$(CP) $(addprefix $(TOP)/,$(EXTMOD_C)) $(TOP)/extmod/*.h $(PACKAGE_DIR)/extmod
	$(Q)$(CP) $(TOP)/shared/readline/readline.[ch] $(PACKAGE_DIR)/shared/readline
	$(Q)$(CP) $(addprefix $(TOP)/,$(filter shared/runtime/%,$(SHARED_C))) \
		$(TOP)/shared/runtime/gchelper.h $(TOP)/shared/runtime/interrupt_char.h \
		$(TOP)/shared/runtime/pyexec.h $(PACKAGE_DIR)/shared/runtime
	$(Q)$(CP) $(TOP)/shared/timeutils/timeutils.[ch] $(PACKAGE_DIR)/shared/timeutils
	$(Q)$(CP) $(TOP)/lib/re1.5/*.[ch] $(PACKAGE_DIR)/lib/re1.5
	$(Q)$(CP) $(TOP)/lib/crypto-algorithms/sha256.[ch] $(PACKAGE_DIR)/lib/crypto-algorithms
	$(Q)$(CP) $(FROZEN_C) $(PACKAGE_DIR)/frozen
	$(Q)$(CP) $(GENHDR_OUTPUT) $(PACKAGE_DIR)/genhdr
	$(Q)$(CP) $(TOP)/LICENSE $(PACKAGE_DIR)/LICENSE
	$(Q)cd $(PACKAGE_DIR) && { \
		echo "# Generated by tools/micropython: the MicroPython sources TinyDesk builds."; \
		echo "# lib/re1.5 and lib/crypto-algorithms are #included by extmod/modre.c"; \
		echo "# and extmod/modhashlib.c, not built on their own."; \
		echo "set(TD_MICROPYTHON_SRCS"; \
		find py extmod shared frozen -name '*.c' | LC_ALL=C sort | sed 's|^|    $${TD_MICROPYTHON_DIR}/|'; \
		echo ")"; \
	} > sources.cmake

include $(TOP)/py/mkrules.mk
